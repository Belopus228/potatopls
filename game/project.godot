; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Меллстройность 3D"
config/description="Фанатская 3D-пародия: Общага, Мурино, Молочное, Мытищи, Банька и ФОГ."
config/version="2.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.05, 0.07, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

G="*res://src/core/g.gd"
Inp="*res://src/core/inp.gd"
Snd="*res://src/core/snd.gd"
T="*res://src/test/t.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/default_font_multichannel_signed_distance_field=false

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="мир"
3d_physics/layer_2="игрок"
3d_physics/layer_3="существа"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.05, 1)

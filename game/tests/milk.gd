extends RefCounted
## Село Молочное: кондукторша -> Дед -> сарай -> трансформатор -> гнездо -> трамвай -> Матка -> обратно.


func run(t) -> void:
	G.save = G.new_save()
	G.save["inv"] = {"phone": 1, "spray": 1, "am": 1, "kicks": 1, "chain": 1, "doshik": 2, "shawa": 1}
	G.save["money"] = 30
	await t.start("milk", "start", false)
	var L = G.level
	t.say(t.state())
	var down: bool = await t.walk(Vector3(0, 0, 62), 10.0)
	t.ok(down and G.player.global_position.y < 0.3, "сошёл с платформы: " + str(G.player.global_position))
	await L.kond.talk()
	t.ok(G.flag("mk_talk"), "кондукторша рассказала про ток и ручку")
	var road: bool = await t.walk(Vector3(0, 0, 20), 14.0)
	road = await t.walk(Vector3(0, 0, -40), 20.0) and road
	t.ok(road, "прошёл по улице до конца села")
	await L.ded.talk()
	t.ok(G.flag("mk_ded"), "Дед разрешил зайти в сарай")
	t.tp(6.4, 0.1, -52, -PI * 0.5)
	await t.sim(0.3)
	t.ok(G.player.near != null and String(G.player.near["label"]) == "Открыть сарай", "у двери сарая")
	await t.use()
	t.kill_all()
	var inb: bool = await t.walk(Vector3(13, 0, -52), 8.0)
	await t.sim(0.5)
	t.ok(inb and G.ents.size() >= 4, "в сарае началась драка: врагов %d" % G.ents.size())
	var won: bool = await t.fight(70.0)
	await t.sim(0.5)
	won = await t.fight(70.0) and won
	await t.sim(0.5)
	if not G.flag("mk_barn"):
		G.player.revive()
		t.kill_all()
		await t.sim(0.5)
		t.kill_all()
		await t.sim(0.5)
	t.ok(G.flag("mk_barn"), "сарай зачищен (бот: %s, hp %d)" % [won, int(G.player.hp)])
	G.player.revive()
	await t.walk(Vector3(15, 0, -52), 6.0)
	await t.sim(0.6)
	t.ok(G.has("fuse"), "предохранитель подобран")
	t.tp(27.0, 0.1, 30, -PI * 0.5)
	t.kill_all()
	await t.sim(0.3)
	await t.use()
	await t.flush()
	t.ok(G.flag("mk_power") and not G.has("fuse"), "ток включён")
	t.tp(0, 0.1, -58, 0)
	var thru: bool = await t.walk(Vector3(0, 0, -68), 8.0)
	t.ok(thru, "ворота электропастуха открыты")
	t.kill_all()
	var path: bool = await t.walk(Vector3(-4, 0, -76), 8.0)
	path = await t.walk(Vector3(-16, 0, -86), 10.0) and path
	path = await t.walk(Vector3(-26, 0, -96), 10.0) and path
	path = await t.walk(L.NEST + Vector3(0, 0, 0.2), 10.0, 0.5) and path
	t.ok(path, "тропа до гнезда проходима: " + str(G.player.global_position))
	t.kill_all()
	G.player.face(L.NEST + Vector3(0, 0, -2.5))
	await t.sim(0.3)
	await t.use()
	await t.flush()
	await t.sim(0.5)
	t.ok(G.ents.size() >= 5, "гнездо проснулось: врагов %d" % G.ents.size())
	won = await t.fight(80.0)
	await t.sim(0.6)
	won = await t.fight(80.0) and won
	await t.sim(0.6)
	if not G.flag("mk_nest"):
		G.player.revive()
		t.kill_all()
		await t.sim(0.5)
		t.kill_all()
		await t.sim(0.5)
	t.ok(G.flag("mk_nest"), "гнездо зачищено (бот: %s, hp %d)" % [won, int(G.player.hp)])
	G.player.revive()
	await t.walk(L.NEST + Vector3(0, 0, 0.5), 6.0)
	await t.sim(0.6)
	t.ok(G.has("handle"), "ручка у меня")
	await L.kond.talk()
	await t.flush()
	t.ok(G.flag("mk_ride") and G.player.global_position.x > 100.0, "трамвай привёз в яму: " + str(G.player.global_position))
	await t.walk(L.PIT + Vector3(0, 0, 12), 8.0)
	await t.sim(0.5)
	await t.flush()
	t.ok(L.boss.active, "бой с Маткой начался")
	won = await t.fight(200.0)
	t.say("бой с Маткой: %s, игрок hp %d" % ["победа" if won else "нет", int(G.player.hp)])
	if not won:
		G.player.revive()
		t.kill_all()
	await t.sim(3.0)
	await t.flush()
	t.ok(G.flag("mk_boss") and G.has("btn1"), "Матка побеждена, кнопка «1» получена")
	t.tp(L.PIT.x + 4.5, 0.1, L.PIT.z + 27.4, PI)
	await t.sim(0.3)
	await t.use()
	await t.flush()
	t.ok(G.player.global_position.x < 20.0, "трамвай вернул в село: " + str(G.player.global_position))
	var up: bool = await t.walk(Vector3(0, 0, 60), 8.0)
	up = await t.walk(Vector3(1.5, 0.9, 72), 10.0) and up
	t.ok(up and G.player.global_position.y > 0.7, "поднялся на платформу")
	t.say(t.state())
